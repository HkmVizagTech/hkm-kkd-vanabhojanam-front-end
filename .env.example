# Copy to .env.local (local) or set in Vercel (production). There are no built-in defaults for the first two.
REACT_APP_API_URL=https://YOUR-KAKINADA-BACKEND            # the Railway/Cloud Run address of the Kakinada backend
REACT_APP_RAZORPAY_KEY=rzp_live_xxxxxxxxxxxx               # the Kakinada Razorpay key id (public)
# Optional: this site's own address (defaults to the address the page is opened on)
# REACT_APP_SITE_URL=https://YOUR-KAKINADA-SITE
# Optional: where the home page pictures are served from (defaults to the shared R2 public bucket)
# REACT_APP_ASSETS_URL=https://files.harekrishnavizag.org/site/vanabhojanam
